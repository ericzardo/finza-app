{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["bun-types"],
		"strict": true,
		"skipLibCheck": true,
		"baseUrl": ".",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"paths": {
			"@env": ["src/env.ts"],
			"@client": ["src/client.ts"],
			"@/*": ["src/*"]
		}
	},
	"include": ["src/**/*", "generated/**/*", "kubb.config.ts"],
	"exclude": ["generated/mocks/**/*"]
}
