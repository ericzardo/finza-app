generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Plan {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  price      Decimal  @db.Decimal(12, 2)
  features   Json
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  users      User[]

  @@map("plans")
}

model User {
  id                 String            @id @default(cuid())
  name               String
  email              String            @unique
  password           String
  avatar_url         String?           @default("/avatars/1.webp")
  is_privacy_enabled Boolean           @default(false)
  email_verified_at  DateTime?
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt
  plan_id            String?
  tokens             Token[]
  plan               Plan?             @relation(fields: [plan_id], references: [id])
  workspace_members  WorkspaceMember[]

  @@map("users")
}

model Token {
  id         String    @id @default(cuid())
  token      String    @unique
  type       TokenType
  user_id    String
  expires_at DateTime
  created_at DateTime  @default(now())
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("tokens")
}

model Workspace {
  id                   String               @id @default(cuid())
  name                 String
  currency             String               @default("BRL")
  created_at           DateTime             @default(now())
  updated_at           DateTime             @updatedAt
  bank_accounts        BankAccount[]
  buckets              Bucket[]
  categories           Category[]
  credit_cards         CreditCard[]
  invoices             Invoice[]
  transaction_patterns TransactionPattern[]
  transactions         Transaction[]
  members              WorkspaceMember[]

  @@map("workspaces")
}

model WorkspaceMember {
  id           String        @id @default(cuid())
  workspace_id String
  user_id      String
  role         WorkspaceRole @default(EDITOR)
  invited_at   DateTime      @default(now())
  accepted_at  DateTime?
  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  workspace    Workspace     @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@unique([workspace_id, user_id])
  @@map("workspace_members")
}

model BankAccount {
  id           String        @id @default(cuid())
  workspace_id String
  name         String
  provider     String?
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt
  workspace    Workspace     @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  credit_cards CreditCard[]
  transactions Transaction[]

  @@index([workspace_id])
  @@map("bank_accounts")
}

model Bucket {
  id                    String               @id @default(cuid())
  workspace_id          String
  name                  String
  type                  BucketType           @default(SPENDING)
  allocation_percentage Decimal              @db.Decimal(5, 2)
  is_default            Boolean              @default(false)
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt
  workspace             Workspace            @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  transaction_patterns  TransactionPattern[]
  transaction_splits    TransactionSplit[]
  transactions          Transaction[]

  @@index([workspace_id])
  @@map("buckets")
}

model Category {
  id                   String               @id @default(cuid())
  workspace_id         String
  name                 String
  icon                 String?
  color                String?
  created_at           DateTime             @default(now())
  updated_at           DateTime             @updatedAt
  workspace            Workspace            @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  transaction_patterns TransactionPattern[]
  transactions         Transaction[]

  @@index([workspace_id])
  @@map("categories")
}

model CreditCard {
  id              String        @id @default(cuid())
  workspace_id    String
  bank_account_id String?
  name            String
  provider        String
  last_digits     String?
  limit           Decimal       @db.Decimal(12, 2)
  closing_day     Int
  due_day         Int
  interest_rate   Decimal       @default(0) @db.Decimal(5, 2)
  late_fee_rate   Decimal       @default(0) @db.Decimal(5, 2)
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  bank_account    BankAccount?  @relation(fields: [bank_account_id], references: [id])
  workspace       Workspace     @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  invoices        Invoice[]
  transactions    Transaction[]

  @@index([workspace_id])
  @@map("credit_cards")
}

model Invoice {
  id             String        @id @default(cuid())
  workspace_id   String
  credit_card_id String
  month          Int
  year           Int
  status         InvoiceStatus @default(OPEN)
  due_date       DateTime
  paid_at        DateTime?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  credit_card    CreditCard    @relation(fields: [credit_card_id], references: [id], onDelete: Cascade)
  workspace      Workspace     @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  transactions   Transaction[]

  @@unique([credit_card_id, month, year])
  @@map("invoices")
}

model TransactionPattern {
  id                 String        @id @default(cuid())
  workspace_id       String
  bucket_id          String?
  category_id        String?
  description        String
  type               PatternType
  amount             Decimal       @db.Decimal(12, 2)
  installments_count Int?
  paid_installments  Int?          @default(0)
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt
  bucket             Bucket?       @relation(fields: [bucket_id], references: [id])
  category           Category?     @relation(fields: [category_id], references: [id])
  workspace          Workspace     @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  transactions       Transaction[]

  @@index([workspace_id])
  @@map("transaction_patterns")
}

model Transaction {
  id                     String              @id @default(cuid())
  workspace_id           String
  bank_account_id        String?
  credit_card_id         String?
  invoice_id             String?
  bucket_id              String?
  category_id            String?
  transaction_pattern_id String?
  type                   TransactionType
  amount                 Decimal             @db.Decimal(12, 2)
  description            String
  date                   DateTime
  is_paid                Boolean             @default(true)
  installment_number     Int?
  canceled_at            DateTime?
  canceled_by            String?
  cancellation_reason    String?
  created_at             DateTime            @default(now())
  updated_at             DateTime            @updatedAt
  splits                 TransactionSplit[]
  bank_account           BankAccount?        @relation(fields: [bank_account_id], references: [id])
  bucket                 Bucket?             @relation(fields: [bucket_id], references: [id])
  category               Category?           @relation(fields: [category_id], references: [id])
  credit_card            CreditCard?         @relation(fields: [credit_card_id], references: [id])
  invoice                Invoice?            @relation(fields: [invoice_id], references: [id])
  transaction_pattern    TransactionPattern? @relation(fields: [transaction_pattern_id], references: [id])
  workspace              Workspace           @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
  @@index([date])
  @@map("transactions")
}

model TransactionSplit {
  id             String      @id @default(cuid())
  transaction_id String
  bucket_id      String
  amount         Decimal     @db.Decimal(12, 2)
  bucket         Bucket      @relation(fields: [bucket_id], references: [id], onDelete: Cascade)
  transaction    Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  @@index([transaction_id])
  @@index([bucket_id])
  @@map("transaction_splits")
}

enum WorkspaceRole {
  OWNER
  EDITOR
  VIEWER
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PAID
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum PatternType {
  INSTALLMENT
  RECURRING
}

enum BucketType {
  SPENDING
  INVESTMENT
  INBOX
}

enum TokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}
