{
  "name": "@finza/api",
  "version": "0.0.1",
  "private": true,
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "typecheck": "bunx tsc --noEmit",
    "dev": "bun --env-file=.env.dev --hot src/index.ts",
    "stage": "bun --env-file=.env.stage src/index.ts",
    "prod": "bun --env-file=.env.prod src/index.ts",
    "test": "bun test --env-file=.env.test --timeout 10000",
    "lint": "eslint .",
    "seed": "bun --env-file=.env db/prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@prisma/client": "7.4.2",
    "@prisma/extension-accelerate": "^3.0.1",
    "@scalar/fastify-api-reference": "^1.49.0",
    "bcrypt": "^6.0.0",
    "fastify": "^5.8.2",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/config": "^7.4.2",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.5",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "bun-types": "^1.3.10",
    "dotenv": "^17.3.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prisma": "^7.4.2",
    "typescript-eslint": "^8.56.1"
  }
}